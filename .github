# ─────────────────────────────────────────────────────────────
# GitHub에 소스코드를 올리면(push) 자동으로 APK를 만들고,
# 만든 APK를 같은 저장소의 apk/carpersona.apk 로 올려 주는 설정입니다.
#
#   소스코드 push → (약 3~5분) → apk/carpersona.apk 자동 갱신
#                               + Releases 의 "latest" 에도 첨부
#
# 진행 상황: 저장소 위쪽 [Actions] 탭. 초록 ✓ 성공, 빨간 ✗ 실패.
# ─────────────────────────────────────────────────────────────
name: Build APK

on:
  push:
    branches: [ main ]
    # APK나 문서만 바뀐 경우에는 다시 빌드하지 않음
    paths-ignore:
      - "apk/**"
      - "docs/**"
      - "**.md"
  pull_request:
  workflow_dispatch:   # [Actions] 탭에서 "Run workflow" 버튼으로 직접 실행

permissions:
  contents: write      # apk 폴더에 커밋하고 Releases 를 만들기 위해 필요

concurrency:
  group: build-apk-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: 소스코드 가져오기
        uses: actions/checkout@v4

      - name: Java 17 설치
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Gradle 준비
        uses: gradle/actions/setup-gradle@v4

      - name: APK 빌드
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --stacktrace

      - name: APK 이름 정리
        run: |
          mkdir -p apk
          cp app/build/outputs/apk/debug/app-debug.apk apk/carpersona.apk
          ls -la apk

      - name: Actions 결과물로 보관 (90일)
        uses: actions/upload-artifact@v4
        with:
          name: carpersona-apk
          path: apk/carpersona.apk

      - name: 저장소 apk 폴더에 APK 올리기
        if: github.event_name != 'pull_request'
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add apk/carpersona.apk
          if git diff --cached --quiet; then
            echo "APK 변경 없음"
            exit 0
          fi
          git commit -m "APK 자동 빌드 (${GITHUB_SHA::7}) [skip ci]"
          # 그 사이 누가 새로 push 했다면, 그 push 의 빌드가 APK를 다시 올리므로 여기선 넘어갑니다.
          git push origin "HEAD:${GITHUB_REF_NAME}" || echo "새 커밋이 있어 다음 빌드에서 APK가 갱신됩니다."

      - name: Releases 의 latest 에 APK 첨부
        if: github.event_name != 'pull_request'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          gh release delete latest --yes --cleanup-tag || true
          gh release create latest apk/carpersona.apk \
            --title "CAR PERSONA 최신 APK" \
            --notes "main 브랜치 커밋 ${GITHUB_SHA::7} 에서 자동으로 만든 APK입니다." \
            --target "$GITHUB_SHA"
