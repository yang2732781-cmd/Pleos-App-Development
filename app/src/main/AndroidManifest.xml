<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Pleos 차량 "조회" 권한 (제어 CONTROL_* 권한은 하나도 쓰지 않습니다).
      공식 샘플 앱과 같은 이름이며, 일반 폰에서는 그냥 무시됩니다.
    -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />   <!-- 실내 온도 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />     <!-- 문 열림 -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />   <!-- 창문 열림 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />     <!-- 뒷좌석 탑승 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />    <!-- 전조등·실내등 -->
    <uses-permission android:name="pleos.car.permission.CAR_MILEAGE" />   <!-- 주행 거리·시간 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />     <!-- 주행 모드 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />    <!-- 연료·배터리 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />    <!-- 워셔액 경고 -->
    <uses-permission android:name="pleos.car.permission.CAR_TIRES" />     <!-- 타이어 저압 -->
    <uses-permission android:name="pleos.car.permission.READ_WINDSHIELD_WIPERS" /> <!-- 와이퍼 -->

    <!-- NaviHelper: 목적지 확인·경로 요청 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_agenda"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <!-- 차량(Android Automotive)에서 주행 중에도 화면을 띄울 수 있다고 표시.
                 주행 중 화면은 큰 글자·최소 정보만 보여 주고, 일기장은 잠급니다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
