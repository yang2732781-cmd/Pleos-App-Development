<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Pleos 차량 "조회" 권한 (제어 CONTROL_* 권한은 하나도 쓰지 않습니다).
      공식 샘플 앱과 같은 이름이며, 일반 폰에서는 그냥 무시됩니다.
    -->
    <!-- 권한 이름은 공식 문서 "Vehicle 권한" 표 기준 (2026-11-06 확인) -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />      <!-- CarInfo: 차대번호(연식) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />     <!-- Odometer·DrivingMode: 누적/이번 주행 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />    <!-- EvBattery·Fuel: 배터리·연료 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />    <!-- Safety·Tire: 경고 -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />   <!-- HVAC: 실내 온도 -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />   <!-- Wiper: 비 -->

    <!-- NaviHelper: 목적지·도착·현재 위치 (조회) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- 음성으로 묻기 (안드로이드 기본 음성 인식) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Claude API (AI 대화를 켰을 때만 사용) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 차량(Android Automotive / Pleos Connect)용 앱. required=false 라서 일반 폰에도 설치되어 시연할 수 있음 -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.CarPersona">
        <!-- 주행 제한(CarUxRestrictions)을 쓰려고 차량 라이브러리를 불러옴. 폰에는 없으므로 required=false -->
        <uses-library android:name="android.car" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <!-- 주행 중 방해 최소화(DO) 앱이라고 선언. 대신 앱이 CarUxRestrictions 를 받아
                 주행 중에는 글자 입력·설정·그래프 화면을 숨기고, 차의 말은 한 문장으로 줄입니다 (DrivingRestriction.kt). -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
